{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title"  : "Response",
  "type"   : "object",
  "properties": {
    "data"        : { "type": ["array", "object", "null"] },
    "pagination"  : {
      "type"      : ["object", "null"],
      "properties": {
        "page"        : { "type": "integer" },
        "pageSize"    : { "type": "integer" },
        "totalRecords": { "type": "integer" },
        "totalPages"  : { "type": "integer" }
      }
    },
    "token": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"] }
  }
}