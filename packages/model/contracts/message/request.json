{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title"  : "Request",
  "type"   : "object",
  "required": ["metadata"],
  "properties": {
    "metadata": {
      "type"    : "object",
      "required": ["tipo"],
      "properties": {
        "catalogoID"    : { "type": "string", "format": "uuid" },
        "tipo"          : { "type": "string", "enum": ["NaoInformado","Erro","Qualidade","Compliance","Desempenho","Backend","Frontend"] },
        "justificativa" : { "type": "string", "minLength": 10 }
      }
    },
    "payload": { "type": "object" }
  }
}